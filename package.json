{
  "name": "grebla",
  "version": "1.177.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "description": "GREBLA — Gestión Reflexiva de Equipos Bajo un Liderazgo Afectivo. Framework de herramientas para equipos y personas (primera: Role Mirror).",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "PUBLIC_APP_VERSION=$(git rev-parse --short HEAD) astro build && node scripts/stamp-sw.mjs",
    "build:tribbu": "PUBLIC_APP_VERSION=$(git rev-parse --short HEAD) astro build --mode tribbu && node scripts/stamp-sw.mjs",
    "publish:version": "node scripts/publish-version.mjs",
    "publish:version:tribbu": "node scripts/publish-version.mjs tribbu",
    "deploy:all": "node scripts/deploy-all.mjs",
    "merge:green": "node scripts/merge-when-green.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "test:coverage": "vitest run --no-file-parallelism --coverage",
    "e2e": "firebase emulators:exec --only auth,firestore,functions --project demo-grebla \"playwright test\"",
    "sonar": "npx @sonar/scan",
    "assets": "node scripts/gen-assets.mjs",
    "seed": "node scripts/seed.mjs",
    "seed:tenant-admin": "node scripts/seed-tenant-admin.mjs",
    "seed:leaders": "node scripts/seed-leaders.mjs",
    "seed:career-content": "node scripts/seed-career-content.mjs",
    "seed:archipelago": "node scripts/seed-archipelago.mjs",
    "seed:islands": "node scripts/seed-islands.mjs",
    "seed:career-routes": "node scripts/seed-career-routes.mjs",
    "seed:areas": "node scripts/seed-areas.mjs",
    "seed:o2o": "node scripts/seed-o2o.mjs"
  },
  "dependencies": {
    "@astrojs/lit": "^4.3.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "@manufosela/loading-layer": "^2.0.1",
    "@manufosela/multi-select": "^2.1.0",
    "@webcomponents/template-shadowroot": "^0.2.1",
    "astro": "^7.2.4",
    "d3-hierarchy": "^3.1.2",
    "firebase": "^12.14.0",
    "lit": "^3.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^4.1.11",
    "firebase-admin": "^13.10.0",
    "sharp": "^0.35.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@firebase/util",
      "protobufjs"
    ],
    "overrides": {
      "websocket-driver": "^0.7.5",
      "form-data": "^2.5.6",
      "js-yaml": "^4.3.1",
      "fast-uri": "^3.1.5",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.18",
      "svgo": "^4.0.2",
      "sharp": "^0.35.0",
      "protobufjs": "^7.6.5",
      "uuid": "^11.1.1",
      "yaml": "^2.8.3",
      "esbuild": "^0.28.1"
    }
  }
}
